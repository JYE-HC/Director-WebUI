DIRECTOR_HOST=127.0.0.1
DIRECTOR_PORT=8787
# Optional startup override. The built-in default is
# <Director project>/.data/database/director.sqlite3.
# Prefer the Settings migration action so the current SQLite WAL is copied safely.
# DIRECTOR_DATABASE_PATH=/absolute/path/to/director.sqlite3
# DIRECTOR_STORAGE_CONFIG_PATH=/absolute/path/to/storage.json
